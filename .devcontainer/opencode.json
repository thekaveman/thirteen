{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "{file:/home/node/app/specs/requirements.md}",
    "{file:/home/node/app/specs/tasks.md}",
    "{file:/home/node/app/specs/wishlist.md}"
  ],
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 8000
    },
    "buffer": 20000
  },
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 32768
  },
  "providers": {
    "llama": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://host.docker.internal:9999/v1"
      },
      "models": {
        "local": {
          "name": "qwen3.6-35b",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        }
      }
    }
  },
  "model": "llama/local"
}

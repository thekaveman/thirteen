{
  "name": "thirteen",
  "version": "2025.10.1",
  "description": "A web-based implementation of the card game Thirteen (Ti\u1ebfn L\u00ean), built with vanilla JavaScript, HTML, and CSS.",
  "main": "src/app.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "tsc && cp src/*.html src/*.css src/logo.png dist/",
    "start": "npm run build && http-server dist -p 8888",
    "test": "npm run build && npx mocha --require @babel/register --extensions ts --require ./tests/setup.ts tests/test_*.ts tests/**/*.ts"
  },
  "nyc": {
    "all": true,
    "include": [
      "src/app/**/*.js"
    ],
    "exclude": [
      "tests"
    ],
    "reporter": [
      "text",
      "html"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thekaveman/thirteen.git"
  },
  "keywords": [],
  "author": "thekaveman",
  "license": "Apache-2.0",
  "type": "module",
  "bugs": {
    "url": "https://github.com/thekaveman/thirteen/issues"
  },
  "homepage": "https://thekaveman.github.io/thirteen/src/",
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/register": "^7.28.3",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "chai": "^6.2.0",
    "eslint": "^10.15.0",
    "http-server": "^14.1.1",
    "jsdom": "^27.0.0",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "sinon": "^21.0.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.8"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.49.2"
  }
}
